{
	"name": "auth-service",
	"version": "1.0.0",
	"description": "Boilerplate for Typescript Node application",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
		"dev": "NODE_ENV=development node --watch src/index.ts",
		"prestart": "npm run build",
		"start": "node dist/index.js",
		"test": "NODE_ENV=test node --test \"tests/**/*.test.ts\"",
		"test-coverage": "NODE_ENV=test node --test --experimental-test-coverage \"tests/**/*.test.ts\"",
		"test-invoke": "node ./src/test-invoke.ts",
		"check": "biome check --write",
		"format": "biome format --write",
		"lint": "biome lint",
		"lint:write": "biome lint --write",
		"clean": "rm -rf dist build"
	},
	"author": "ikenley",
	"license": "SEE LICENSE IN LICENSE.txt",
	"repository": {
		"type": "git",
		"url": "https://github.com/ikenley/auth-service"
	},
	"dependencies": {
		"@aws-sdk/client-cognito-identity-provider": "^3.1106.0",
		"@aws-sdk/client-dynamodb": "^3.1105.0",
		"@aws-sdk/client-ssm": "^3.1105.0",
		"@aws-sdk/lib-dynamodb": "^3.1105.0",
		"@codegenie/serverless-express": "^5.0.0",
		"awilix": "^13.0.5",
		"axios": "^1.19.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
		"express": "^5.2.1",
		"helmet": "^8.3.0",
		"jwt-decode": "^4.0.0",
		"method-override": "^3.0.0",
		"morgan": "^1.11.0",
		"winston": "^3.19.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/aws-lambda": "^8.10.162",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/method-override": "^3.0.0",
		"@types/morgan": "^1.9.10",
		"@types/node": "^26.1.2",
		"@types/supertest": "^7.2.1",
		"supertest": "^7.2.2",
		"typescript": "^6.0.3"
	}
}
